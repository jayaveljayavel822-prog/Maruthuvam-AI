# Maruthuvam.AI Environment Variables

# Project Settings
PROJECT_NAME="Maruthuvam.AI – AI Health Copilot"
ENVIRONMENT="development"
DEBUG=true

# Database (defaults to SQLite if not provided, or PostgreSQL for production)
DATABASE_URL=sqlite:///./maruthuvam.db
# DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/maruthuvam

# Security & Authentication
JWT_SECRET_KEY=maruthuvam_super_secure_development_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (JSON list format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Storage Service
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# AI Provider Configuration
# Supported providers: simulated, openai, anthropic, gemini
AI_PROVIDER=simulated
AI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini

# OCR Engine Configuration
# Supported: simulated, tesseract, vision_ai
OCR_PROVIDER=simulated

# ABDM / ABHA Sandbox Configuration
ABDM_CLIENT_ID=SBX_MARUTHUVAM_CLIENT
ABDM_CLIENT_SECRET=SBX_SECRET_KEY_DEMO
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway/v0.5
